    * error_msg: Text
    --
    * created_at: Text
    * updated_at: Text
}

entity "t_job_management" {
    * id: Integer<<PK, Not Null, Auto Increment>>
    --
    * job_type: Text
    * db_code: Text
    * db_name: Text
    * process_id: Integer
    * process_name: Text
    * start_tm: Text
    * end_tm: Text
    * status: Text
    * done_percent: Float
    * duration: Float
    * error_msg: Text
    --
    * created_at: Text
    * updated_at: Text
}

entity "t_proc_link" {
    * id: Integer<<PK, Not Null>>
    --
    * job_id: Integer <<FK>>
    * process_id: Integer <<FK>>
    * target_process_id: Integer<<FK>>
    * matched_count: Integer
    --
    * created_at: Text
    * created_at: Text
}

cfg_csv_column ||..o{ cfg_data_source_csv
cfg_data_source_csv ||..o{ cfg_data_source
cfg_data_source_db ||..o{ cfg_data_source
cfg_filter ||..o{ cfg_process
cfg_filter ||..o{ cfg_process_column
