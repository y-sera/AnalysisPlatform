    --
    * created_at: Text
    * updated_at: Text
}

entity "t_factory_import" {
    * id: Integer<<PK, Not Null, Auto Increment>>
    * job_id: Integer<<FK>>
    * process_id: Integer
    * import_type: Text
    * import_from: Text
    * import_to: Text
    * start_tm: Text
    * end_tm: Text
    * imported_row: Integer
